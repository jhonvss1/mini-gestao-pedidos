# Modelo do arquivo de segredos de PRODUÇÃO. No servidor, copie para ".env.producao" (ignorado pelo Git) e preencha.
# Nunca versione os valores reais.

# Senha do administrador do SQL Server (sa). Só o db-init a usa; a API NÃO usa o sa.
# Mínimo de 8 caracteres, com três entre maiúscula, minúscula, dígito e símbolo.
MSSQL_SA_PASSWORD=

# Senha do login restrito app_pedidos, usado pela API. Mesma política de complexidade e NÃO pode conter "app_pedidos".
# Para trocar a senha depois: altere aqui e rode o db-init de novo (ele atualiza o login).
SENHA_APP=

# Token do túnel da Cloudflare (painel Zero Trust > Networks > Tunnels > seu túnel > Docker).
TUNNEL_TOKEN=

# Carga de demonstração (8 clientes, 7 produtos e pedidos de exemplo). Padrão false: banco de produção começa vazio.
# Para uma demonstração pública, use true; a carga só entra se a tabela cliente estiver vazia.
# CARGA_INICIAL=false

# Opcional: limite de memória do SQL Server em MB (padrão 1536).
# MSSQL_MEMORY_LIMIT_MB=1536
